{
  "manifest_version": 3,
  "name": "Job Seeker Helper",
  "version": "0.1.0",
  "description": "Fills job application forms from your Job Seeker pack. You review everything and click Submit yourself.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.indeed.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Seeker Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*"
      ],
      "js": ["content/fill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
