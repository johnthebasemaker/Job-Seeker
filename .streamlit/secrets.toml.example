# Copy to .streamlit/secrets.toml for local work, and paste the same content
# into Streamlit Community Cloud under App settings -> Secrets.
# .streamlit/secrets.toml is gitignored. Never commit real keys.

# ---------------------------------------------------------------- database
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY = "service-role-key-from-supabase-dashboard"

# ------------------------------------------------------------------- users
# Only these Google accounts can sign in. A bare "@domain.com" allows a domain.
ALLOWED_EMAILS = "you@gmail.com, your.friend@gmail.com"

# ---------------------------------------------------------------------- AI
# Groq does not train on API data, and Zero Data Retention can be switched on
# in the Groq console under Settings -> Data Controls. Do that before launch.
LLM_PROVIDER = "groq"
LLM_MODEL = "openai/gpt-oss-120b"
GROQ_API_KEY = "gsk_..."
LLM_DAILY_CALL_LIMIT = "120"

# Optional fallback provider (Cloudflare Workers AI free allowance).
# LLM_PROVIDER = "cloudflare"
# CF_ACCOUNT_ID = "..."
# CF_API_TOKEN = "..."

# ------------------------------------------------------------- job sources
# All optional: whichever keys are present get used.
JSEARCH_API_KEY = "rapidapi-key"     # rapidapi.com/letscrape.../api/jsearch
ADZUNA_APP_ID = ""                   # developer.adzuna.com
ADZUNA_APP_KEY = ""
JOOBLE_API_KEY = ""                  # jooble.org/api/about

DAILY_JOB_TARGET = "20"

# ------------------------------------------------- Google sign-in (st.login)
# Create an OAuth client at console.cloud.google.com, type "Web application".
# Redirect URI: http://localhost:8501/oauth2callback for local work, and
# https://YOUR-APP.streamlit.app/oauth2callback once deployed.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "a-long-random-string"
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
